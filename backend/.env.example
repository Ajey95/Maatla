# Keep provider credentials here on the backend only. Never commit .env.
GNANI_API_KEY=
MAATLA_AGENT_ACCESS_KEY=replace-with-a-long-random-private-key
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_TTS_HINGLISH_VOICE=Poorvi
GNANI_TTS_TELUGU_VOICE=Varuni
MAATLA_LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
MAATLA_TRANSLATION_MODEL=gemma4:latest
MAATLA_PREWARM_LLM=true
MAATLA_TURN_QUIET_SECONDS=9
MAATLA_DEMO_MODE=true
# Edit this list to the sources the seller has approved.
MAATLA_ALLOWED_DOMAINS=bhubharati.telangana.gov.in,registration.telangana.gov.in,meebhoomi.ap.gov.in
BRAVE_SEARCH_API_KEY=
MAATLA_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Required for reliable audio across different networks. Configure your TURN server.
MAATLA_TURN_URL=
MAATLA_TURN_USERNAME=
MAATLA_TURN_CREDENTIAL=
